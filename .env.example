# =============================================================================
# SentryLogin — environment configuration
# Copy this file to .env and adjust as needed.
# =============================================================================

# --- Server -----------------------------------------------------------------
PORT=3000
ML_PORT=8000
FRONTEND_PORT=5173
NODE_ENV=development
# Comma-separated list of allowed browser origins (backend CORS).
# Needed when the frontend is served from a different origin than the API.
CORS_ORIGIN=http://localhost:5173

# --- Database: local dev (SQLite, zero install) -----------------------------
# Default stack: SQLite file DB. No external services required.
DATABASE_TYPE=sqlite
DATABASE_PATH=db/sentry.sqlite

# --- Database: production / Docker opt-in (Postgres) ------------------------
# Switch to Postgres by uncommenting these lines (and the postgres service in
# docker-compose.yml). NOTE: URL-encode special chars in the password (@ -> %40).
# Supabase direct connections are IPv6-only; use the pooler host on IPv4-only
# networks.
# DATABASE_TYPE=postgres
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD%40ENCODED@db.YOUR_REF.supabase.co:5432/postgres

# --- ML Service (risk scoring) ----------------------------------------------
ML_SERVICE_URL=http://localhost:8000

# --- LLM (AI login explanations) ---------------------------------------------
# Optional. Without a key, the explanations module falls back to rule-based text.
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4
